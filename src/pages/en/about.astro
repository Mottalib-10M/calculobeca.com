---
import PageLayout from '../../layouts/PageLayout.astro';
import LegalIdentity from '../../components/LegalIdentity.astro';
import { route } from '../../i18n/routes';
import { AUTHOR_NAME, AUTHOR_DESC, CONTACT_EMAIL } from '../../data/site-config';
import { srcLink } from '../../lib/helpers';
import { profilePageSchema, breadcrumbSchema } from '../../lib/seo';
const lang = 'en';
const path = route('about', lang);
const title = 'Publisher behind Cálculo Beca 2026: independent, BOE-based';
const description = 'Cálculo Beca is published by Radif Partners: free calculators on Spain\'s 2026-2027 study grant built from the BOE. Not the Ministry, files no applications.';
const s = (k: string, t: string) => srcLink(k, lang, t);
---
<PageLayout title={title} description={description} lang={lang} jsonLd={[profilePageSchema({ path, lang }), breadcrumbSchema([{ name: 'Home', path: route('home', lang) }, { name: 'About', path }])]} breadcrumbs={[{ label: 'About' }]}>
  <article class="prose prose-slate max-w-none">
    <h1>About</h1>
    <p class="text-xs font-medium uppercase tracking-wide text-navy-500">Independent site: not the Ministry of Education, handles no applications</p>
    <p>{AUTHOR_DESC.en}</p>
    <h2>Why it exists</h2>
    <p>Finding out whether you qualify means crossing a threshold table by household size, a list of deductions, wealth limits with cadastral coefficients and an academic requirement that differs by field. The pages going round copy the table, sometimes with typos or as an image, and do not do the sum. The Ministry's official simulator only covers the variable part. Here the full sum of fixed amounts takes a minute, with the article next to every figure, and what cannot be forecast is stated plainly.</p>
    <h2>Who publishes it</h2>
    <p>{AUTHOR_NAME}, a company that builds calculators from public rules. It is not a public body, a tutoring school or an agency. It uses no logos or marks of any administration, charges nothing, has no affiliate links and collects no student phone numbers or emails.</p>
    <LegalIdentity lang={lang} />
    <h2>Sources</h2>
    <p>The figures come from <Fragment set:html={s('rd179', 'Royal Decree 179/2026')} />, <Fragment set:html={s('rd1721', 'Royal Decree 1721/2007')} /> and the <Fragment set:html={s('convocatoria', '2026-2027 general call')} />. Based on data from the Agencia Estatal Boletín Oficial del Estado (<a href="https://www.boe.es" rel="nofollow noopener" target="_blank">www.boe.es</a>). The <a href={route('method', lang)}>method</a> explains how they are applied and the <a href={route('editorial', lang)}>editorial policy</a> how they are corrected.</p>
    <h2>What we do not do</h2>
    <p>We file no applications, see no files, award no grants and give no personal advice. The simulator's result is an estimate under the published rules; the decision is the Ministry's. Your data never leaves your browser: see the <a href={route('privacy', lang)}>privacy policy</a>.</p>
    <h2>Write to us</h2>
    <p><a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>, if you find a misread figure or a case the simulator gets wrong.</p>
  </article>
</PageLayout>
