---
import PageLayout from '../../layouts/PageLayout.astro';
import { SITE_URL } from '../../data/site-config';
import { route } from '../../i18n/routes';
import { breadcrumbSchema } from '../../lib/seo';
const lang = 'en';
const code = `<iframe src="${SITE_URL}/embed/${lang}/simulador-beca/" title="Spanish general study grant simulator 2026-2027" width="100%" height="1000" style="border:0;max-width:1100px" loading="lazy"></iframe>`;
---
<PageLayout title="Embed the Spain study grant simulator 2026-2027 for free" description="Embed the 2026-2027 Spanish general study grant simulator for free with an iframe: thresholds, fixed amounts and wealth limits. Figures update when the BOE changes." lang={lang} noindex={true} jsonLd={[breadcrumbSchema([{ name: lang === 'es' ? 'Inicio' : 'Home', path: route('home', lang) }, { name: 'Widget', path: route('widget', lang) }])]} breadcrumbs={[{ label: 'Widget' }]} showAuthor={false}>
  <header class="mb-6">
    <h1 class="text-3xl font-bold text-navy-900 md:text-4xl">Embed the simulator</h1>
    <p class="mt-3 text-lg text-navy-700">For schools, student associations and careers advisers: copy it once and new figures appear on their own when the Official Gazette is updated.</p>
  </header>
  <div class="prose prose-slate max-w-none">
    <pre class="overflow-x-auto rounded-lg bg-navy-900 p-4 text-sm text-white"><code>{code}</code></pre>
    <p set:html={`For the Spanish version, change <code>/embed/en/</code> to <code>/embed/es/</code>. Terms: the link under the simulator stays visible, it is not modified and it comes with no warranty. What your readers type stays on their device. The simulator is not the Ministry of Education and handles no applications.`} />
  </div>
  <div class="mt-8 overflow-hidden rounded-xl border border-navy-200">
    <iframe src={`/embed/${lang}/simulador-beca/`} title="Spanish general study grant simulator 2026-2027" width="100%" height="1000" style="border:0" loading="lazy"></iframe>
  </div>
</PageLayout>
