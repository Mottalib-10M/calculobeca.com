---
import PageLayout from '../../layouts/PageLayout.astro';
import { CONTACT_EMAIL, SITE_NAMES } from '../../data/site-config';
import { route } from '../../i18n/routes';
import { contactPageSchema } from '../../lib/seo';
const lang = 'en';
const description = 'Write to us if a grant figure, threshold or date looks misread, or if you want to embed the simulator. We file no applications and cannot see your file.';
---
<PageLayout title={`Contact ${SITE_NAMES[lang]}: report an error`} description={description} lang={lang} noindex={true} jsonLd={[contactPageSchema({ name: 'Contact', description, path: route('contact', lang), lang })]} breadcrumbs={[{ label: 'Contact' }]} showAuthor={false}>
  <div class="prose prose-slate max-w-none">
    <h1>Contact</h1>
    <p>Email: <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>.</p>
    <h2>A wrong figure or a case handled badly</h2>
    <p>Tell us the page, what you entered and what you expected, and if possible the article of the Royal Decree or the call that backs it. We check the Official Gazette before changing anything.</p>
    <h2>Your grant application</h2>
    <p>This site is not the Ministry of Education and does not handle applications: we cannot see or change your file. For the status of your grant, use «Mis expedientes» on the Ministry's e-office or contact the grants unit of your university or regional department. Do not send us tax returns, ID documents or certificates.</p>
    <h2>Embedding the simulator</h2>
    <p>Schools, student associations and careers advisers can embed it for free: <a href={route('widget', lang)}>instructions</a>.</p>
  </div>
</PageLayout>
