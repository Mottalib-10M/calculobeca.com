---
/**
 * Inicio: el simulador completo arriba, la respuesta en un párrafo plegable, las tres preguntas que decide el
 * Ministerio (renta, patrimonio, rendimiento), dos casos calculados, la tabla de umbrales, las fechas de la
 * convocatoria, las páginas por familia y los textos largos en acordeones. Texto: src/content/home.ts.
 */
import PageLayout from '../layouts/PageLayout.astro';
import Clamp from './Clamp.astro';
import Tool from './Tool.astro';
import AvisoPlazo from './AvisoPlazo.astro';
import { HOME } from '../content/home';
import { route, hasRoute, type Locale } from '../i18n/routes';
import { GROUPS } from '../i18n/nav';
import { t } from '../i18n/ui';
import { sourceList } from '../lib/helpers';
import { LAST_UPDATED } from '../data/site-config';
import { GUIDES } from '../lib/pages';
import { HITOS, quienTxt } from '../lib/tool-specs';
import { displayDate } from '../lib/format';
import { faqSchema, organizationSchema, websiteSchema, webPageSchema, webApplicationSchema } from '../lib/seo';
interface Props { lang: Locale }
const { lang } = Astro.props;
const x = HOME[lang];
const path = route('home', lang);
const sources = sourceList(HOME.sources, lang);
const jsonLd = [websiteSchema(lang), organizationSchema(lang), webPageSchema({ name: x.h1, description: x.description, path, lang }), webApplicationSchema({ name: x.h1, description: x.description, path, lang }), faqSchema(x.faqs, lang)];
const ui = t(lang);
const L = (es: string, en: string) => (lang === 'es' ? es : en);
const perfiles = [
  { id: 'calendario', t: L('Empieza en septiembre de 2027: qué preparar', 'Starting in September 2027: what to prepare') },
  { id: 'residencia', t: L('Estudiará fuera de casa', 'Will study away from home') },
  { id: 'bachillerato', t: L('Bachillerato o FP (formación profesional)', 'Upper secondary or vocational training') },
  { id: 'requisitos', t: L('Ya está en 2.º o más: qué hay que aprobar', 'Already in year 2 or later: what must be passed') },
  { id: 'master', t: L('Máster', "Master's degree") },
  { id: 'denegada', t: L('Os la han denegado o piden papeles', 'Refused, or asked for documents') },
].filter((p) => hasRoute(p.id, lang));
const fecha = (iso: string) => displayDate(iso, lang === 'es' ? 'es-ES' : 'en-GB');
---
<PageLayout title={x.title} description={x.description} lang={lang} jsonLd={jsonLd} faqs={x.faqs} sources={sources}>
  <header class="mb-4">
    <h1 class="text-[1.7rem] font-bold text-navy-900 max-sm:leading-tight sm:text-3xl md:text-4xl">{x.h1}</h1>
    <div class="mt-1 text-xs font-medium uppercase tracking-wide text-navy-500">{ui.independent}</div>
    <p class="mt-2 text-base text-navy-700 sm:text-lg">{x.intro}</p>
  </header>
  <AvisoPlazo lang={lang} />
  <div id="simulador" data-outil data-chrome class="scroll-mt-20"><Tool kind="beca" lang={lang} idPrefix="home" /></div>
  <p class="mt-2 text-sm text-navy-600" data-chrome>{ui.privacyLine}</p>
  {/* Portes d'entrée par profil, juste sous le simulateur (testeurs du 2026-11-10 : la question n° 1 de chacun —
       rentrée 2027, études hors de chez soi, FP, 2.º curso, refus — était dans un 3e lien noyé dans une liste). */}
  <section class="mt-6" aria-labelledby="perfiles-h" data-chrome>
    <h2 id="perfiles-h" class="text-xl font-bold text-navy-900">{L('Tu caso con la beca: por dónde seguir', 'Your beca MEC case: where to go next')}</h2>
    <ul class="mt-3 grid gap-2 sm:grid-cols-2 lg:grid-cols-3">
      {perfiles.map((p) => <li><a href={route(p.id, lang)} class="flex min-h-12 items-center justify-between gap-2 rounded-lg border-2 border-accent-500 bg-white px-4 py-2 font-semibold text-accent-700 hover:bg-accent-50"><span>{p.t}</span><span aria-hidden="true">→</span></a></li>)}
    </ul>
  </section>
  <Clamp text={x.resume} lang={lang} id="clamp-home" class="my-8" />
  <section class="mt-8">
    <h2 class="text-2xl font-bold text-navy-900">{x.stepsTitle}</h2>
    <ol class="mt-4 space-y-3">
      {x.steps.map((s) => (
        <li class="rounded-lg border-l-4 border-accent-500 bg-white px-4 py-3 shadow-sm">
          <a href={route(s.id, lang)} class="font-semibold text-navy-900 hover:underline">{s.q}</a>
          <p class="mt-1 text-sm text-navy-700">{s.a}</p>
        </li>
      ))}
    </ol>
  </section>
  {/* Page plus courte (testeurs du 2026-11-10) : les deux cas chiffrés, la table de 1 à 8 personnes et les cinq replis
       « Para entender la beca a fondo » sont retirés ; chacun a sa page, liée par les cartes ci-dessous. */}
  <section class="mt-10" data-chrome>
    <h2 class="text-2xl font-bold text-navy-900">{x.datesTitle}</h2>
    <p class="mt-1 text-sm text-navy-600">{x.datesNote}</p>
    <ul class="mt-4 border-l-2 border-navy-200 pl-5">
      {HITOS.map((m) => <li class="relative mb-3"><span class="absolute -left-[1.6rem] top-1.5 h-2.5 w-2.5 rounded-full bg-accent-500" aria-hidden="true"></span><time datetime={m.iso} class="tabular-nums text-sm font-semibold text-navy-900">{m.iso < LAST_UPDATED ? '✓ ' : ''}{fecha(m.iso)}</time><span class="block text-sm text-navy-700">{lang === 'es' ? m.es : m.en}</span><span class="block text-xs text-navy-600">{quienTxt(m.quien, lang)}</span></li>)}
    </ul>
    <p class="text-sm"><a href={route('calendario', lang)} class="font-medium text-accent-700 underline">{L('Calendario y qué toca ahora', 'Calendar and what comes next')}</a></p>
  </section>
  <section class="mt-10" data-chrome>
    <h2 class="text-2xl font-bold text-navy-900">{x.guidesTitle}</h2>
    <div class="mt-4 grid gap-x-6 md:grid-cols-3">
      {GROUPS.map((g, gi) => (
        <details class="fold" open={gi === 0}>
          <summary><h3 class="fold-h">{g.label[lang]} ({GUIDES.filter((p) => p.group === g.id && hasRoute(p.id, lang)).length})</h3></summary>
          {/* Des cartes cliquables, comme « Para seguir » : en texte noir, la liste ne se lisait pas comme des liens (test naïf). */}
          <ul class="mt-2 space-y-2 text-sm">
            {GUIDES.filter((p) => p.group === g.id && hasRoute(p.id, lang)).map((p) => <li><a href={route(p.id, lang)} class="block rounded-lg border border-navy-200 px-3 py-2 hover:border-accent-300 hover:bg-accent-50"><span class="font-semibold text-accent-700 underline underline-offset-2">{p[lang].nav} →</span><span class="block text-navy-600">{p[lang].card}</span></a></li>)}
          </ul>
        </details>
      ))}
    </div>
    <p class="mt-6 text-sm text-navy-700"><a href={route('method', lang)} class="font-medium text-accent-700 underline">{L('Cómo calcula el simulador y de dónde salen las cifras', 'How the simulator calculates and where the figures come from')}</a> · <a href={route('about', lang)} class="font-medium text-accent-700 underline">{L('Quién publica este sitio', 'Who publishes this site')}</a></p>
  </section>
</PageLayout>
