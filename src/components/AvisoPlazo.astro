---
/**
 * Bandeau « où en est-on aujourd'hui » (test naïf du 2026-11-08 : les trois testeurs cherchaient en haut de page si le
 * plazo était ouvert ; l'étudiante qui entre en 2027 lisait « 2026-2027 » et « renta 2025 » partout sans savoir si
 * c'était pour elle). Il commence par elle : beca 2027-2028, renta 2026, plazo pas encore publié ; puis ceux qui ont
 * déjà demandé. `corto` : une ligne, sur chaque page de sujet (les visiteurs arrivent de Google sur n'importe laquelle).
 * La solicitud tardía ne reste que sur la page du calendrier (`tardia`).
 * Dates : params-2026.json (plazoInicio, plazoFin, solicitudTardiaHasta) et site-config (LAST_UPDATED).
 */
import P from '../data/params-2026.json';
import { LAST_UPDATED } from '../data/site-config';
import { displayDate } from '../lib/format';
import { route, type Locale } from '../i18n/routes';
interface Props { lang: Locale; enlace?: boolean; corto?: boolean; tardia?: boolean }
const { lang, enlace = true, corto = false, tardia: conTardia = false } = Astro.props;
const tag = lang === 'es' ? 'es-ES' : 'en-GB';
const fin = displayDate(P.convocatoria.plazoFin, tag), ini = displayDate(P.convocatoria.plazoInicio, tag);
const abierto = LAST_UPDATED <= P.convocatoria.plazoFin;
const tardia = conTardia && LAST_UPDATED <= P.convocatoria.solicitudTardiaHasta ? displayDate(P.convocatoria.solicitudTardiaHasta, tag) : '';
const cal = route('calendario', lang);
---
{!abierto && corto && (
  <p data-aviso-plazo class="mb-3 rounded-lg border-l-4 border-amber-500 bg-amber-50 px-3 py-1.5 text-sm text-navy-900">
    {lang === 'es'
      ? <><strong>¿Empiezas en septiembre de 2027?</strong> Pedirás la beca 2027-2028, que, si no cambia la regla, mirará la renta de 2026; las cifras de aquí (2026-2027) te sirven de orientación. <a href={cal} class="font-medium text-accent-700 underline">Fechas</a></>
      : <><strong>Starting in September 2027?</strong> You will apply for the 2027-2028 grant, which, unless the rule changes, will look at 2026 income; the figures here (2026-2027) are a guide. <a href={cal} class="font-medium text-accent-700 underline">Dates</a></>}
  </p>
)}
{!abierto && !corto && (
  <div data-aviso-plazo class="mb-4 rounded-lg border-l-4 border-amber-500 bg-amber-50 px-3 py-2 text-sm text-navy-900">
    {lang === 'es'
      ? <>
          <p><strong>¿Empiezas a estudiar en septiembre de 2027?</strong> Pedirás la beca 2027-2028. Su plazo aún no se ha publicado (este año fue del {ini} al {fin}) y, si se mantiene la regla actual, contará la renta de 2026 de tu familia. Mientras tanto, el simulador usa las cifras de 2026-2027 para darte una idea.</p>
          <p class="mt-1"><strong>¿Ya pediste la de 2026-2027?</strong> El plazo cerró el {fin}: vigila «Mis notificaciones».{tardia && ` Fuera de plazo solo cabe la solicitud tardía, hasta el ${tardia}, si el sustentador principal (quien más ingresa en casa) fallece o se jubila de forma forzosa.`}{enlace && <>{' '}<a href={cal} class="font-medium text-accent-700 underline">Qué preparar antes del próximo plazo</a></>}</p>
        </>
      : <>
          <p><strong>Starting your studies in September 2027?</strong> You will apply for the 2027-2028 grant. Its window has not been published yet (this year it ran from {ini} to {fin}) and, if the current rule is kept, your family's 2026 income will count. Meanwhile, the simulator uses the 2026-2027 figures to give you an idea.</p>
          <p class="mt-1"><strong>Already applied for 2026-2027?</strong> The window closed on {fin}: keep an eye on «Mis notificaciones».{tardia && ` Outside the window, only a late application is possible, until ${tardia}, if the main earner dies or is forced to retire.`}{enlace && <>{' '}<a href={cal} class="font-medium text-accent-700 underline">What to prepare before the next window</a></>}</p>
        </>}
  </div>
)}
